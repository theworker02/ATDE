ATDE_LIVE=1
# ATDE_DRY_RUN=1
# ATDE_LOCAL_FIREWALL=0
NATS_URL=nats://127.0.0.1:4222
# Operator console token (optional; empty = open on loopback demos)
# ATDE_OPS_TOKEN=
# Slack/Discord/generic JSON catch webhook
# ATDE_WEBHOOK_URL=
# ATDE_WEBHOOK_TOKEN=
# --- Encrypted owner email alerts (recommended) ---
# ATDE_ALERT_TO=you@example.com
# ATDE_ALERT_FROM=atde@yourdomain.com
# ATDE_SMTP_HOST=smtp.yourdomain.com
# ATDE_SMTP_PORT=587
# ATDE_SMTP_USER=
# ATDE_SMTP_PASS=
# ATDE_SMTP_TLS=starttls
# Path to owner's OpenPGP public key (ASCII-armored) — body is encrypted to this key
# ATDE_PGP_PUBLIC_KEY_FILE=./secrets/owner.asc
# ATDE_PGP_REQUIRE=1
# ATDE_ALERT_MIN_SEVERITY=40
# ATDE_ALERT_COOLDOWN=15m
# ATDE_ALERT_BOOT=1
# ATDE_NODE_NAME=vps-catch-1
# ATDE_CONSOLE_URL=http://YOUR_PUBLIC_IP:9091/console
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# AWS_WAF_IPSET_ID=
# AWS_WAF_IPSET_NAME=
# AWS_WAF_SCOPE=REGIONAL
# AWS_REGION=us-east-1
# AWS_WAF_BLOCK_ENDPOINT=
# WAF_BLOCK_WEBHOOK=
# SIEM_WEBHOOK_URL=
# COREDNS_REWRITE_API=
# CF_GATEWAY_REWRITE_URL=
# ABUSEIPDB_API_KEY=
# MISP_URL=
# MISP_API_KEY=
# MASTODON_ACCESS_TOKEN=
# MASTODON_INSTANCE_URL=
# BLUESKY_POST_WEBHOOK=
# GITHUB_TOKEN=
# GOOGLE_SAFE_BROWSING_API_KEY=
# GOOGLE_SB_REPORT_ENDPOINT=
# HOSTING_ABUSE_API_URL=
# CLOUDFLARE_ABUSE_API_URL=
# ATDE_MASTER_KEY=
